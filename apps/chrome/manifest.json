{
  "manifest_version": 3,
  "name": "tokei / wasm",
  "version": "0.1.0",
  "description": "Count source code on GitHub, GitLab, Codeberg, Forgejo, sourcehut, Gitee, Bitbucket, SourceForge and Hugging Face with Rust/Wasm.",
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze with tokei",
    "default_icon": {
      "16": "favicon-16x16.png",
      "32": "favicon-32x32.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://gitlab.com/*",
    "https://codeberg.org/*",
    "https://code.forgejo.org/*",
    "https://gitea.com/*",
    "https://git.sr.ht/*",
    "https://gitee.com/*",
    "https://api.bitbucket.org/*",
    "https://sourceforge.net/*",
    "https://git.code.sf.net/*",
    "https://huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https:"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
