{
  "name": "tokei-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build:web && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:extensions": "node scripts/build.mjs chrome firefox",
    "package:extensions": "node scripts/build.mjs chrome firefox --zip",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:extensions": "npm run build:extensions && playwright test --config playwright.extensions.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
